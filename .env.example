# ============================================================
# AI Frontend Generation Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# API Key Configuration
# Set OPENROUTER_API_KEY for OpenRouter or GROQ_API_KEY for Groq
# Get OpenRouter key at https://openrouter.ai
# ----------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
GROQ_API_KEY=your_primary_groq_api_key_here

# ----------------------------------------------------------
# Model Selection
# Vision model — must support image input
# OpenRouter Free: qwen/qwen3.6-27b:free or qwen/qwen-2.5-vl-72b-instruct:free
# Groq: meta-llama/llama-4-scout-17b-16e-instruct
# ----------------------------------------------------------
VISION_MODEL=qwen/qwen3.6-27b:free

# ----------------------------------------------------------
# Code / Instruction model (no vision required)
# OpenRouter Free: qwen/qwen3-coder:free or qwen/qwen-2.5-coder-32b-instruct:free
# Groq: llama-3.3-70b-versatile
# ----------------------------------------------------------
CODE_MODEL=qwen/qwen3-coder:free

# ----------------------------------------------------------
# Output language for generated React components
# Options: tsx  |  jsx
# ----------------------------------------------------------
OUTPUT_LANGUAGE=tsx

# ----------------------------------------------------------
# Output directory (relative to project root)
# ----------------------------------------------------------
OUTPUT_DIR=output

# ----------------------------------------------------------
# Web UI settings
# ----------------------------------------------------------
UI_HOST=127.0.0.1
UI_PORT=5000
UI_DEBUG=false

# ----------------------------------------------------------
# Agent behaviour
# Max retry attempts when LLM returns malformed JSON
# ----------------------------------------------------------
MAX_JSON_RETRIES=3

# ----------------------------------------------------------
# Token Budget Management
# Controls how many output tokens are requested per API call.
#
# Free Tier (Groq):
#   llama-3.3-70b-versatile → 6,000 TPM → use MAX_TOKENS_CODE=4000
#   llama-3.1-8b-instant    → 20,000 TPM → use MAX_TOKENS_CODE=6000
#
# Paid Tier (Groq):
#   Can safely use MAX_TOKENS_CODE=8000
#
# Rule of thumb: MAX_TOKENS_CODE + estimated input tokens < model TPM limit
# ----------------------------------------------------------
MAX_TOKENS_CODE=6000
MAX_TOKENS_VISION=4000
